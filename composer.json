{
    "name": "arsy/sso-client",
    "description": "Cliente unificado de Single Sign-On (SSO) para aplicaciones del ecosistema Arsy.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/socialite": "^5.0",
        "socialiteproviders/laravelpassport": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "Arsy\\SSOClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arsy\\SSOClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arsy\\SSOClient\\Providers\\SsoClientServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
